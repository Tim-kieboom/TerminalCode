// TerminalCode settings. Comments and trailing commas are allowed.
// This file is read at startup and again whenever it is saved.
{
    // The theme to start with: the name of a file in the themes folder (without
    // .toml). null is the built-in fallback, which is not a theme you can choose.
    // The built-in Dark, Light, SolDark and SolLight are templates: "Theme: New..."
    // in the command palette makes a theme from one, and chooses it. Choosing a
    // theme from the palette lasts for the run only; set it here to keep it.
    "theme": null,

    // The program the terminal pane runs, for example "fish" or "/bin/zsh".
    // null is your own shell ($SHELL, or cmd.exe on Windows). A change applies
    // to terminal tabs started after it; a tab that is running keeps its shell.
    // If the shell cannot start, the platform's own is tried and you are told.
    "shell": null,

    // Whether the mouse is on at the start. With it on, clicks, drags and the
    // wheel reach the editor and the terminal's own text selection needs shift;
    // with it off the terminal handles the mouse. alt+m switches it for the run.
    "mouse": true,

    // How many columns wide a tab character draws, from 1 to 16, and how many
    // columns one level of indentation is when it is made of spaces (the Tab key
    // inserts spaces up to the next multiple of it). The file is not touched.
    "tab_size": 4,

    // What the Tab key inserts: "spaces" or "tabs".
    "indent_style": "spaces",

    // true: a file that already has indentation keeps the style and width it
    // uses (two spaces, four spaces or tabs), and the two settings above apply
    // to files with none. false: the two settings above apply to every file.
    "detect_indent": true,

    // How long, in milliseconds, a half-typed key sequence such as ctrl+k ctrl+i
    // waits for its next key, from 200 to 5000. When it runs out the sequence is
    // dropped (what you typed is not sent anywhere) and the status bar shows the
    // keys while it waits. 0 waits for ever. The ctrl+b prefix of the terminal pane
    // has its own wait of one second.
    "sequence_timeout": 1000,

    // How many seconds a plain message (saved, copied, reloaded) stays on screen,
    // from 1 to 60. A change applies to the messages shown after it. Errors stay
    // until you press a key or click, whatever this is.
    "notification_seconds": 4,

    // true: the explorer leaves out the entries your .gitignore (and the other
    // ignore rules) leave out, such as target/ and node_modules/. false: it lists
    // them dimmed. The file finder and the project search never list them.
    "hide_ignored": false,

    // More places to install plugins from: the URLs of plugin indexes (an index.json
    // like the one of the official plugins), for example
    //   ["https://raw.githubusercontent.com/you/trcode-plugins/main/index.json"]
    // Their plugins are listed in "Plugins: Manage" beside the official ones, marked with
    // where they come from, and installing one asks first. Only https addresses of
    // github.com and githubusercontent.com work, and an official plugin's name
    // cannot be taken by a source. A plugin that came from a source is updated only
    // from that source.
    "plugin_sources": [],

    // What a plugin that gets the text of the files you open (the capability
    // "files.text", for example a markdown preview) may get, by plugin id: the file
    // extensions, without the dot. A plugin's manifest names the most it can get, and
    // this only narrows that: { "markdown": ["md"] } leaves a plugin that wants "md"
    // and "markdown" files with "md" only, [] with none. A plugin not named here gets
    // everything its manifest names (and that you allowed when you turned it on).
    "plugin_file_types": {},

    // Language servers, by name. These are the ones there are: Rust, Nix and JSON.
    // Your entry for one of them overrides only the fields you write, and keeps the
    // rest from here, so this is enough to change one thing:
    //
    //   "language_servers": { "rust": { "format_on_save": true } }
    //
    // null turns a server off, and any other name adds a server (which needs its
    // "command" and "extensions"). A list, such as "args", is replaced, not added to.
    // Fields:
    //   "command"                 the program to run, found on your PATH
    //   "args"                    its arguments
    //   "extensions"              the files it serves, without the dot
    //   "root_files"              the outermost folder with one of these is its project
    //   "initialization_options"  sent to the server as they are
    //   "language_ids"            what the server is told a file is, by file name
    //   "format_on_save"          true: saving a file first formats it with the server
    //                             (for Rust, rust-analyzer runs rustfmt with your
    //                             rustfmt.toml). A server that is not ready (10
    //                             seconds), has no formatter, fails or takes more than
    //                             2 seconds never blocks the save: the file is saved as
    //                             it is, and a message says why. Quitting waits for the
    //                             saves, and ctrl+q again skips the formatting.
    "language_servers": {
        "rust": {
            "command": "rust-analyzer",
            "extensions": ["rs"],
            "root_files": ["Cargo.toml"],
            "format_on_save": true
        },
        "nix": {
            "command": "nil",
            "extensions": ["nix"],
            "root_files": ["flake.nix"],
            "format_on_save": false
        },
        "json": {
            "command": "vscode-json-language-server",
            "args": ["--stdio"],
            "extensions": ["json", "jsonc"],
            "format_on_save": false
        },
        "javascript": {
            "command": "typescript-language-server",
            "args": ["--stdio"],
            "extensions": ["js", "mjs", "cjs", "jsx"],
            "root_files": ["package.json", "jsconfig.json"],
            "format_on_save": false
        }
    }
}
