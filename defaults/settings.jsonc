// TerminalCode settings. Comments and trailing commas are allowed.
// This file is read at startup and again whenever it is saved.
{
    // The theme to start with: the name of a file in the themes folder (without
    // .toml). null is the built-in fallback, which is not a theme you can choose.
    // The built-in Dark, Light, SolDark and SolLight are templates: "Theme: New..."
    // in the command palette makes a theme from one, and chooses it. Choosing a
    // theme from the palette lasts for the run only; set it here to keep it.
    "theme": null,

    // The program the terminal pane runs, for example "fish" or "/bin/zsh".
    // null is your own shell ($SHELL, or cmd.exe on Windows). A change applies
    // to terminal tabs started after it; a tab that is running keeps its shell.
    // If the shell cannot start, the platform's own is tried and you are told.
    "shell": null,

    // Whether the mouse is on at the start. With it on, clicks, drags and the
    // wheel reach the editor and the terminal's own text selection needs shift;
    // with it off the terminal handles the mouse. alt+m switches it for the run.
    "mouse": true,

    // How many columns wide a tab character draws, from 1 to 16, and how many
    // columns one level of indentation is when it is made of spaces (the Tab key
    // inserts spaces up to the next multiple of it). The file is not touched.
    "tab_size": 4,

    // What the Tab key inserts: "spaces" or "tabs".
    "indent_style": "spaces",

    // true: a file that already has indentation keeps the style and width it
    // uses (two spaces, four spaces or tabs), and the two settings above apply
    // to files with none. false: the two settings above apply to every file.
    "detect_indent": true,

    // How long, in milliseconds, a half-typed key sequence such as ctrl+k ctrl+i
    // waits for its next key, from 200 to 5000. When it runs out the sequence is
    // dropped (what you typed is not sent anywhere) and the status bar shows the
    // keys while it waits. 0 waits for ever. The ctrl+b prefix of the terminal pane
    // has its own wait of one second.
    "sequence_timeout": 1000,

    // How many seconds a plain message (saved, copied, reloaded) stays on screen,
    // from 1 to 60. A change applies to the messages shown after it. Errors stay
    // until you press a key or click, whatever this is.
    "notification_seconds": 4,

    // true: the explorer leaves out the entries your .gitignore (and the other
    // ignore rules) leave out, such as target/ and node_modules/. false: it lists
    // them dimmed. The file finder and the project search never list them.
    "hide_ignored": false,

    // Language servers, by name. Rust is built in (rust-analyzer, found on your PATH),
    // so this is empty unless you want to change that. An entry with the name of a
    // built-in server replaces it whole, null turns it off, any other name adds one:
    //
    //   "language_servers": {
    //       "rust": {
    //           "command": "rust-analyzer",          // the program to run
    //           "args": [],                          // its arguments
    //           "extensions": ["rs"],                // the files it serves
    //           "root_files": ["Cargo.toml"],        // the outermost folder with one is its project
    //           "initialization_options": {          // sent to the server as they are
    //               "cargo": { "features": "all" }
    //           }
    //       }
    //   }
    "language_servers": {}
}
